# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by 'npx convex dev'
CONVEX_DEPLOYMENT=

# Reference only: set this secret in the Convex deployment environment (not Vite/browser env or Vercel frontend env).
# Never commit the actual value. See docs/DEPLOYMENT.md.
VLY_EMAIL_API_KEY=
